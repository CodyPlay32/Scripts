-- Anti-Update Script corregido para Delta Executor

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local LocalPlayer = Players.LocalPlayer

if not LocalPlayer then
    warn("Esperando LocalPlayer...")
    repeat wait() until Players.LocalPlayer
    LocalPlayer = Players.LocalPlayer
end

-- Valores iniciales
local startPlaceVersion = game.PlaceVersion
local startJobId = game.JobId
local kicked = false

local function kick(reason)
    if kicked then return end
    kicked = true
    LocalPlayer:Kick("Juego actualizado. Reconecta: " .. reason)
end

-- Método 1: Detectar cambio de versión
spawn(function()
    while wait(2) do
        if kicked then break end
        
        local success, currentVersion = pcall(function()
            return game.PlaceVersion
        end)
        
        if success and currentVersion ~= startPlaceVersion then
            kick("Versión " .. startPlaceVersion .. "→" .. currentVersion)
            break
        end
    end
end)

-- Método 2: Detectar cambio de JobId
spawn(function()
    while wait(1) do
        if kicked then break end
        
        if game.JobId ~= startJobId then
            kick("Nuevo servidor")
            break
        end
    end
end)

-- Método 3: Detectar fallo de teleport (este sí existe)
TeleportService.TeleportInitFailed:Connect(function(player, result, msg)
    if player == LocalPlayer and not kicked then
        kick("Teleport fallido")
    end
end)

-- Método 4: Detectar llegada de teleport (cambio de servidor)
TeleportService.LocalPlayerArrivedFromTeleport:Connect(function()
    if not kicked then
        kick("Llegada de teleport")
    end
end)

print("Anti-update activado - PlaceVersion: " .. startPlaceVersion)
