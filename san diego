-- Anti-Update Script para Delta Executor
-- Solo saca al jugador, no cierra el juego

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Guardar valores iniciales
local initialPlaceVersion = game.PlaceVersion
local initialJobId = game.JobId
local initialPlaceId = game.PlaceId

-- Mensaje al ser expulsado
local kickMessage = "El juego se ha actualizado. Reconectando..."

-- Función para expulsar
local function kickPlayer(reason)
    LocalPlayer:Kick(kickMessage .. " (" .. reason .. ")")
end

-- Verificación cada 3 segundos
while task.wait(3) do
    -- Detectar cambio de versión del lugar
    if game.PlaceVersion ~= initialPlaceVersion then
        kickPlayer("Versión cambiada: " .. initialPlaceVersion .. " → " .. game.PlaceVersion)
        break
    end
    
    -- Detectar cambio de servidor
    if game.JobId ~= initialJobId then
        kickPlayer("Servidor cambiado")
        break
    end
    
    -- Detectar cambio de lugar
    if game.PlaceId ~= initialPlaceId then
        kickPlayer("Lugar cambiado")
        break
    end
end
